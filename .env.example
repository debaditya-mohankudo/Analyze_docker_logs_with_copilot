# Docker Log Analyzer configuration.
# Copy to .env and edit. All settings are optional — see defaults in
# docker_log_analyzer/config.py (Settings class).

# Logging
LOG_LEVEL=INFO
LOG_FILE_ENABLED=true
LOG_FILE_PATH=.cache/app_logs/docker-log-analyzer.jsonl
LOG_FILE_MAX_BYTES=10000000
LOG_FILE_BACKUP_COUNT=3

# Docker
DOCKER_HOST=unix:///var/run/docker.sock
CONTAINER_LABEL_FILTER=

# Tool parameter defaults
DEFAULT_TAIL_LINES=500
DEFAULT_SPIKE_TAIL_LINES=1000
DEFAULT_WINDOW_MINUTES=5
DEFAULT_SPIKE_THRESHOLD=2.0
DEFAULT_CORRELATION_WINDOW_SECONDS=30
CORRELATION_CACHE_TTL_MINUTES=30

# Code repository resolution (for analyze_code_context)
# REPO_PATHS=["/home/user/myapp","/srv/services/api"]
# CONTAINER_REPO_MAP={"api-service":"/home/user/api","worker":"/home/user/worker"}
CODE_CONTEXT_LINES=10
MAX_STACK_FRAMES=10

# Request tracing
TRACE_WINDOW_SECONDS=120
